# Copy to .env and adjust. Never commit .env.
# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=cipher
POSTGRES_USER=cipher
POSTGRES_PASSWORD=cipher

# ── Backend ───────────────────────────────────────────────────────
# dev seeds demo users (alice, bob, echo). Use prod for real deployments.
SPRING_PROFILES_ACTIVE=dev
# HS256 signing secret for JWTs. MUST be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# Where encrypted attachment blobs are stored inside the backend container.
ATTACHMENTS_PATH=/data/blobs

# ── Optional: MinIO (docker compose --profile minio up) ───────────
MINIO_ROOT_USER=cipher
MINIO_ROOT_PASSWORD=cipher-minio-change-me
