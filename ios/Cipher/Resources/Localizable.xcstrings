    "demo.echo.attachment.received": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got your %@ (%@). The key came inside the ciphertext, so I decrypted it right here."
          }
        }
      }
    },
    "demo.echo.capsule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sealed at %@. This capsule unlocks %lld seconds later; patience is a feature."
          }
        }
      }
    },
    "demo.echo.disappearing.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disappearing messages are off in this chat. Turn them on from the header menu and I'll follow the same timer."
          }
        }
      }
    },
    "demo.echo.disappearing.on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages here disappear %@ after they're read. Mine follow the same timer."
          }
        }
      }
    },
    "demo.echo.greeting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I'm Echo 👋 I'm a second Cipher client living inside this very app, with my own identity keys in a separate Keychain slot and my own message store. Everything between us is sealed end-to-end; the relay only ever sees ciphertext. Say “help” to see what I can do."
          }
        }
      }
    },
    "demo.echo.greeting.again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey again 👋 Still here, still encrypted. Say “help” for the menu."
          }
        }
      }
    },
    "demo.echo.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here's what I understand:\n• help — this list\n• photo — a view-once picture I draw on this device\n• capsule — a Time Capsule that unlocks %lld seconds later\n• whisper — a message you hold to reveal\n• disappear — this chat's disappearing setting\n• ping — pong\nReply to one of my messages and I'll quote you back. Add a ! and I'll react."
          }
        }
      }
    },
    "demo.echo.help.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “help” and I'll list what I can do."
          }
        }
      }
    },
    "demo.echo.photo.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawn just now with CoreGraphics, no metadata, encrypted before upload. View once — then it's gone."
          }
        }
      }
    },
    "demo.echo.pong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pong 🏓 Sealed, signed and decrypted without leaving this device."
          }
        }
      }
    },
    "demo.echo.system.disappearingChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noticed you changed the disappearing timer. I'll match whatever your next message uses."
          }
        }
      }
    },
    "demo.echo.system.keyVerified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You verified my keys — now it's mutual, as far as I'm concerned. 🔐"
          }
        }
      }
    },
    "demo.echo.system.screenshot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screenshot? I saw that. 👀"
